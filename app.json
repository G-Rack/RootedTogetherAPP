{
  "expo": {
    "name": "Rooted Together",
    "slug": "rooted-together",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "rootedtogether",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "club.rootedtogether.app",
      "usesAppleSignIn": true,
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.rootedtogether.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#6B4226",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "plugins": [
      "expo-apple-authentication",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#6B4226",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Rooted Together needs access to your photos so you can add pictures to your profile and offerings."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "8f2fcba7-57ea-4368-b6ff-382ecadb6202"
      }
    },
    "owner": "rooted-togethers-team",
    "updates": {
      "url": "https://u.expo.dev/8f2fcba7-57ea-4368-b6ff-382ecadb6202"
    }
  }
}
